# Application
APP_NAME=TalentIntelligence
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talent_intelligence
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/talent_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI / LLM
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# API Settings
API_KEY_HEADER=X-API-Key
DEFAULT_API_KEY=dev-api-key-change-in-production
RATE_LIMIT=100/minute

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
